Options -Indexes
Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; frame-src 'self' https://www.google.com https://maps.google.com https://www.openstreetmap.org;"
RewriteEngine On

# Rediriger les URLs avec .php vers sans .php (IONOS : racine /)
# EXCLURE admin/ et ajax/ pour ne pas casser les POST
RewriteCond %{REQUEST_URI} !^/admin/ [NC]
RewriteCond %{THE_REQUEST} \s/+([^.]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Réécriture interne : /index → index.php (préserve le POST)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]
